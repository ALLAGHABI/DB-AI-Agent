{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}

{% block page_css %}
@page { size: A4 landscape; margin: 9mm; }
.appbar {
  background: linear-gradient(120deg, var(--brand-deep), #065f46);
  color: #fff; padding: 15px 22px; position: relative; overflow: hidden;
}
.appbar::after {
  content: ''; position: absolute; inset: 0; opacity: .07;
  background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 12px 12px;
}
.appbar-in { max-width: 1240px; margin: 0 auto; display: flex; flex-wrap: wrap;
  align-items: center; justify-content: space-between; gap: 12px; position: relative; }
.appbar h1 { font-size: 19px; font-weight: 800; letter-spacing: -.01em; }
.appbar .mark { font-size: 11px; letter-spacing: .16em; opacity: .75; text-transform: uppercase; }
.pills { display: flex; flex-wrap: wrap; gap: 6px; }
.pills span {
  border: 1px solid rgb(255 255 255 / .28); background: rgb(255 255 255 / .1);
  border-radius: 999px; padding: 2px 10px; font-size: 11px;
}
.wrap { max-width: 1240px; margin: 0 auto; padding: 16px 22px 26px; }
.strap {
  font-size: 13px; color: var(--ink-2); background: var(--card); border: 1px solid var(--line);
  border-inline-start: 3px solid var(--brand); border-radius: 10px; padding: 10px 14px;
  margin-bottom: 14px;
}
/* شبكة من 12 خانة منفَّذة بـflex لا بـgrid: متصفح الطباعة يقسّم شبكة CSS
   الممتدة على صفحتين تقسيماً خاطئاً فتتراكب البطاقات في PDF. */
.grid12 { --gap: 14px; display: flex; flex-wrap: wrap; gap: var(--gap); align-items: flex-start; }
/* خصائص مفردة لا اختصار flex: المتصفح لا يحسب var() داخل الاختصار فيُهمل السطر */
.grid12 > * {
  flex-grow: 0; flex-shrink: 1;
  flex-basis: calc((var(--span, 12) / 12) * (100% + var(--gap)) - var(--gap));
  min-width: 0;
}
/* شريط المؤشرات يوزّع نفسه على عرضه مهما كان عددها — لا خانات معلّقة */
.kpi-strip { display: flex; flex-wrap: wrap; gap: 14px; }
.kpi-strip > * { flex: 1 1 155px; }
.block { margin-bottom: 14px; }
.block:empty { display: none; margin: 0; }
.rail { --span: 4; }
.rail ol.findings li { font-size: 12.5px; }
.band-head {
  --span: 12; font-size: 11px; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; color: var(--ink-3); margin-top: 4px;
}
.conc { --span: 4; }
@media print {
  /* النسب نفسها عند الطباعة — تغيير الأعمدة يزيح البطاقات عن مقاسات
     لوحات الرسم المحسوبة سلفاً. */
  .grid12 { --gap: 9px; }
  .wrap { padding: 12px 0 0; max-width: none; }
  .card, .rail { break-inside: avoid; }
  .cwrap { height: 180px; } .cwrap.hero { height: 215px; }
  .cwrap.tall { height: 235px; } .cwrap.short { height: 155px; }
}
/* «screen» ضرورية: عرض ورقة A4 نحو 790 بكسل، فقاعدة الشاشات الضيقة كانت
   تنطبق على الطباعة وتفرد كل بطاقة على عرض الصفحة. */
@media screen and (max-width: 900px) {
  .grid12 > * { flex-basis: 100% !important; }
}
{% endblock %}

{% block content %}
<header class="appbar">
  <div class="appbar-in">
    <div>
      <div class="mark">SmartDB · {{ variant_badge }}</div>
      <h1>{{ title }}</h1>
    </div>
    <div class="pills">
      {% if period %}<span class="num">{{ period[0] }} → {{ period[1] }}</span>{% endif %}
      <span class="num">{{ t.rows }}: {{ "{:,}".format(profile.overview.rows) }}</span>
      <span><bdi>{{ source_name }}</bdi></span>
      <span class="num">{{ created_at }}</span>
    </div>
  </div>
</header>

<div class="wrap">
  {% if 'summary' in sections and insights.summary %}
  <div class="strap">{{ insights.summary }}</div>
  {% endif %}

  {# كل كتلة شبكة مستقلة: Chromium يقسّم شبكةً واحدة عبر صفحتين تقسيماً خاطئاً
     فتتراكب البطاقات في PDF — الفصل يجعل الفاصل بين الكتل لا داخلها. #}
  {% if kpis %}
  <div class="kpi-strip block">{% for k in kpis[:6] %}{{ m.kpi_card(k) }}{% endfor %}</div>
  {% endif %}

  {% if hero or ('findings' in sections and insights.findings) %}
  <div class="grid12 block">
    {% if hero %}{{ m.chart_card(hero, hero=true) }}{% endif %}
    {% if 'findings' in sections and insights.findings %}
    <div class="card rail">
      <div class="kicker">{{ t.findings }}</div>
      <ol class="findings" style="margin-top:8px">
        {% for f in insights.findings[:5] %}<li>{{ f }}</li>{% endfor %}
      </ol>
    </div>
    {% endif %}
  </div>
  {% endif %}

  <div class="grid12 block">
    {% if concentration %}{{ m.conc_card(concentration, t) }}{% endif %}

    {% set ns = namespace(band=None) %}
    {% for c in tiles %}
      {% if c.band and c.band != ns.band %}
        {% set ns.band = c.band %}
        <div class="band-head">{{ t.table }}: {{ c.band }}</div>
      {% endif %}
      {{ m.chart_card(c) }}
    {% endfor %}
  </div>

  <div class="grid12 block">
    {% if 'recommendations' in sections and insights.recommendations %}
    <div class="card" style="--span: 12">
      <div class="kicker">{{ t.recommendations }}</div>
      <ul class="recs" style="margin-top:8px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));display:grid">
        {% for r in insights.recommendations %}<li>{{ r }}</li>{% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>

  {{ m.report_foot(t, created_at, model_label, source_name, quality_note, dropped_claims) }}
</div>
{% endblock %}
