<!DOCTYPE html>
<html lang="{{ language }}" dir="{{ 'rtl' if language == 'ar' else 'ltr' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<style>
/* SmartDB report — light document, print-friendly. Palette: dataviz reference. */
:root {
  --surface: #fcfcfb;
  --card: #ffffff;
  --ink: #0b0b0b;
  --ink-2: #52514e;
  --ink-3: #8a8983;
  --line: #e8e7e3;
  --series-1: {{ brand_color }};
  --accent: #1baf7a;
  --brand: {{ brand_color }};
}
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  background: var(--surface); color: var(--ink);
  font-family: {{ "'IBM Plex Sans Arabic', 'Segoe UI', Tahoma" if language == 'ar' else "'Inter', 'Segoe UI'" }}, system-ui, sans-serif;
  line-height: 1.6; font-size: 15px;
}
.page { max-width: 900px; margin: 0 auto; padding: 40px 32px; }
header.report-head {
  border-bottom: 3px solid var(--brand); padding-bottom: 20px; margin-bottom: 28px;
  display: flex; justify-content: space-between; align-items: flex-end; gap: 16px;
}
.report-head h1 { font-size: 26px; font-weight: 700; }
.report-head .meta { color: var(--ink-2); font-size: 12.5px; text-align: end; }
.badge {
  display: inline-block; background: var(--brand); color: #fff; border-radius: 999px;
  padding: 2px 12px; font-size: 11.5px; font-weight: 600; margin-bottom: 8px;
}
h2 { font-size: 17px; font-weight: 700; margin: 30px 0 12px; display: flex; align-items: center; gap: 8px; }
h2::before { content: ''; width: 5px; height: 18px; border-radius: 3px; background: var(--brand); display: inline-block; }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
.tile { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; }
.tile .v { font-size: 24px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
.tile .l { font-size: 12px; color: var(--ink-2); margin-top: 2px; }
.summary-card {
  background: var(--card); border: 1px solid var(--line); border-inline-start: 4px solid var(--brand);
  border-radius: 12px; padding: 18px 20px; font-size: 15px;
}
ul.points { padding-inline-start: 22px; display: grid; gap: 8px; }
ul.points li::marker { color: var(--brand); }
.charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 16px; }
.chart-card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 16px; }
.chart-card h3 { font-size: 13px; font-weight: 600; color: var(--ink-2); margin-bottom: 10px; font-family: ui-monospace, monospace; }
.chart-card .cwrap { position: relative; height: 240px; }
table.data { width: 100%; border-collapse: collapse; background: var(--card); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; font-size: 13px; }
table.data th, table.data td { padding: 8px 12px; border-bottom: 1px solid var(--line); text-align: start; }
table.data th { background: #f4f3f0; font-weight: 600; font-size: 12px; }
table.data tr:last-child td { border-bottom: none; }
.cols { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; }
.col-card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; font-size: 12.5px; }
.col-card .name { font-family: ui-monospace, monospace; font-weight: 700; font-size: 13px; }
.col-card .kind { color: var(--brand); font-size: 11px; font-weight: 600; }
.col-card dl { display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; margin-top: 6px; color: var(--ink-2); }
.col-card dd { text-align: end; font-variant-numeric: tabular-nums; color: var(--ink); }
footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--ink-3); font-size: 11.5px; display: flex; justify-content: space-between; }
@media print {
  .page { padding: 0; max-width: none; }
  .chart-card, .tile, .summary-card, .col-card { break-inside: avoid; }
  h2 { break-after: avoid; }
  body { font-size: 12px; }
}
</style>
</head>
<body>
<div class="page">
  <header class="report-head">
    <div>
      <span class="badge">{{ t.badge }}</span>
      <h1>{{ title }}</h1>
    </div>
    <div class="meta">
      {{ t.generated }}: {{ created_at }}<br>
      {{ t.source }}: {{ source_name }}<br>
      {{ t.engine }}: {{ model_label }}
    </div>
  </header>

  <section>
    <div class="tiles">
      <div class="tile"><div class="v">{{ "{:,}".format(profile.overview.rows) }}</div><div class="l">{{ t.rows }}</div></div>
      <div class="tile"><div class="v">{{ profile.overview.cols }}</div><div class="l">{{ t.cols }}</div></div>
      <div class="tile"><div class="v">{{ profile.overview.missing_pct }}%</div><div class="l">{{ t.missing }}</div></div>
      <div class="tile"><div class="v">{{ profile.overview.duplicate_rows }}</div><div class="l">{{ t.duplicates }}</div></div>
    </div>
  </section>

  {% if insights.summary %}
  <h2>{{ t.summary }}</h2>
  <div class="summary-card">{{ insights.summary }}</div>
  {% endif %}

  {% if insights.findings and variant != 'dashboard' %}
  <h2>{{ t.findings }}</h2>
  <ul class="points">
    {% for f in insights.findings %}<li>{{ f }}</li>{% endfor %}
  </ul>
  {% endif %}

  {% if profile.charts %}
  <h2>{{ t.charts }}</h2>
  <div class="charts">
    {% for c in profile.charts %}
    <div class="chart-card">
      <h3>{{ c.title }}</h3>
      <div class="cwrap"><canvas id="chart-{{ loop.index }}"></canvas></div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if insights.recommendations and variant != 'dashboard' %}
  <h2>{{ t.recommendations }}</h2>
  <ul class="points">
    {% for r in insights.recommendations %}<li>{{ r }}</li>{% endfor %}
  </ul>
  {% endif %}

  {% if variant == 'detailed' %}
  <h2>{{ t.columns }}</h2>
  <div class="cols">
    {% for col in profile.columns %}
    <div class="col-card">
      <span class="name">{{ col.name }}</span> <span class="kind">{{ col.kind }}</span>
      <dl>
        <dt>{{ t.nulls }}</dt><dd>{{ col.nulls }}</dd>
        <dt>{{ t.unique }}</dt><dd>{{ col.unique }}</dd>
        {% if col.kind == 'numeric' and col.mean is not none %}
        <dt>{{ t.mean }}</dt><dd>{{ col.mean }}</dd>
        <dt>{{ t.range }}</dt><dd>{{ col.min }} – {{ col.max }}</dd>
        <dt>{{ t.outliers }}</dt><dd>{{ col.outliers }}</dd>
        {% endif %}
      </dl>
    </div>
    {% endfor %}
  </div>

  <h2>{{ t.sample }}</h2>
  <div style="overflow-x:auto">
  <table class="data">
    <thead><tr>{% for c in profile.sample_columns %}<th>{{ c }}</th>{% endfor %}</tr></thead>
    <tbody>
      {% for row in profile.sample %}
      <tr>{% for v in row %}<td>{{ '—' if v is none else v }}</td>{% endfor %}</tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}

  <footer>
    <span>SmartDB — {{ t.footer }}</span>
    <span dir="ltr">ALI ALLAGHABI · +966551499154 · ALI.ALLAGHABI@gmail.com</span>
    <span>{{ created_at }}</span>
  </footer>
</div>

<script>{{ chartjs_source }}</script>
<script>
const CHARTS = {{ charts_json }};
const S1 = getComputedStyle(document.documentElement).getPropertyValue('--series-1').trim();
const INK2 = getComputedStyle(document.documentElement).getPropertyValue('--ink-2').trim();
const LINE = getComputedStyle(document.documentElement).getPropertyValue('--line').trim();
Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
Chart.defaults.color = INK2;
CHARTS.forEach((c, i) => {
  const ctx = document.getElementById('chart-' + (i + 1));
  if (!ctx) return;
  const common = {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { display: false }, tooltip: { rtl: {{ 'true' if language == 'ar' else 'false' }} } },
    scales: {
      x: { grid: { display: false }, ticks: { maxRotation: 45, autoSkip: true, maxTicksLimit: 12 } },
      y: { grid: { color: LINE }, border: { display: false }, beginAtZero: true },
    },
  };
  if (c.type === 'line') {
    new Chart(ctx, { type: 'line', data: { labels: c.labels, datasets: [{
      data: c.values, borderColor: S1, borderWidth: 2, pointRadius: 0,
      pointHoverRadius: 5, pointHoverBackgroundColor: S1, tension: 0.25, fill: false,
    }]}, options: common });
  } else {
    new Chart(ctx, { type: 'bar', data: { labels: c.labels, datasets: [{
      data: c.values, backgroundColor: S1,
      borderRadius: { topLeft: 4, topRight: 4 }, borderSkipped: 'bottom',
      categoryPercentage: c.type === 'histogram' ? 1.0 : 0.8,
      barPercentage: c.type === 'histogram' ? 0.98 : 0.85, maxBarThickness: 44,
    }]}, options: common });
  }
});
</script>
</body>
</html>
